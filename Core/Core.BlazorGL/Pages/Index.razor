@page "/"
@page "/index.html"
@inject IJSRuntime JsRuntime
@using nkast.Wasm.Canvas

<div id="canvasHolder" style="
    background: #000;
    margin:0%;
    position: fixed;
    top: 0px;
    right: 0px;
    bottom: 0px;
    left: 0px;
    width:100vw;
    height:100vh;
">
    <canvas id="theCanvas" style="touch-action:none;"></canvas>
    
    @if (!started)
    {
        <div style="
            position:absolute;
            top:0; left:0; right:0; bottom:0;
            display:flex;
            align-items:center;
            justify-content:center;
            background:rgba(0,0,0,0.85);
            cursor:pointer;
            user-select:none;
        " @onclick="StartGame">
            <div style="
                text-align:center;
            ">
                Click to Start
            </div>
        </div>
    }
</div>
