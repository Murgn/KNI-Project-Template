
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:Windows
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/packageReference:KNI.Extended.Content.Pipeline 5.3.1

#---------------------------------- Content ---------------------------------#

#begin fonts/Quan.fnt
/importer:BitmapFontImporter
/processor:BitmapFontProcessor
/build:fonts/Quan.fnt

#begin fonts/QuanGum.fnt
/copy:fonts/QuanGum.fnt

#begin fonts/QuanGum_0.png
/copy:fonts/QuanGum_0.png

#begin fonts/Quan_0.png
/importer:TextureImporter
/processor:TextureProcessor
/build:fonts/Quan_0.png

#begin screens/GameplayScreen.xml
/copy:screens/GameplayScreen.xml

#begin DiagnosticsFont.xnb
/copy:DiagnosticsFont.xnb

